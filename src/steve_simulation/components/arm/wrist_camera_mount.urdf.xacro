<?xml version="1.0"?>
<!-- Dummy end-effector with wrist camera for real robot (no gripper) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wrist_camera_mount">

            <!-- Get tf_prefix from parent scope -->
            <xacro:arg name="tf_prefix" default="ur5e"/>
            <xacro:property name="tf_prefix" value="$(arg tf_prefix)"/>
            <xacro:arg name="use_gazebo" default="true"/>

            <material name="mount_grey">
              <color rgba="0.7 0.7 0.7 1"/>
            </material>

            <!-- Dummy end-effector link (replaces gripper adapter) -->
            <joint name="tool0_to_dummy_ee_joint" type="fixed">
              <parent link="${tf_prefix}tool0"/>
              <child link="dummy_end_effector"/>
              <origin xyz="0 0 0" rpy="0 0 0"/>
            </joint>

            <link name="dummy_end_effector">
              <visual>
                <origin xyz="0 0 0.025" rpy="0 0 0"/>
                <geometry>
                  <!-- Simple cylinder representing the mounting plate -->
                  <cylinder radius="0.04" length="0.05"/>
                </geometry>
                <material name="mount_grey"/>
              </visual>
              <collision>
                <origin xyz="0 0 0.025" rpy="0 0 0"/>
                <geometry>
                  <cylinder radius="0.04" length="0.05"/>
                </geometry>
              </collision>
              <inertial>
                <mass value="0.2"/>
                <origin xyz="0 0 0.025" rpy="0 0 0"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
              </inertial>
            </link>

            <!-- Include wrist camera -->
            <xacro:include filename="$(find steve_simulation)/components/cameras/wrist_d405.urdf.xacro"/>
            <xacro:wrist_d405 parent="dummy_end_effector" use_gazebo="$(arg use_gazebo)"/>

</robot>
