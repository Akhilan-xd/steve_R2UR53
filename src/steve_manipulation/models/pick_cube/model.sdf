<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="pick_cube">
    <pose>0 0 0 0 0 0</pose>
    <link name="cube">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.333e-5</ixx>
          <iyy>1.333e-5</iyy>
          <izz>1.333e-5</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
        <surface>
          <!-- Restitution 0, and a capture threshold high enough that a
               finger impact never counts as a bounce. -->
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>100000</threshold>
          </bounce>
          <!-- Gazebo uses the smaller mu of the two surfaces. Match the
               finger pads (mu 100) so the grasp does not slip. -->
          <friction>
            <ode>
              <!-- Match the finger pads. slip 0 keeps that friction from
                   skating once the pads are pressing. -->
              <mu>100</mu>
              <mu2>100</mu2>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
            <!-- Resist the cube twisting out of a shallow pinch. -->
            <torsional>
              <coefficient>10</coefficient>
              <patch_radius>0.02</patch_radius>
              <surface_radius>0.01</surface_radius>
              <use_patch_radius>true</use_patch_radius>
              <ode>
                <slip>0</slip>
              </ode>
            </torsional>
          </friction>
          <contact>
            <ode>
              <!-- kp keeps the 50 g cube from squashing. kd is about
                   2*sqrt(kp*mass) so the contact is critically damped
                   instead of ringing the cube off the fingers.
                   max_vel caps how fast a penetration can be corrected. -->
              <kp>1000000</kp>
              <kd>450</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <!-- A plain SDF color is drawn in Gazebo and then dropped by the depth
           camera. The script has a texture, so the cube shows in the GUI,
           the color image, and the depth image. -->
      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://pick_cube/materials/scripts</uri>
            <uri>model://pick_cube/materials/textures</uri>
            <name>PickCube/Grip</name>
          </script>
        </material>
        <cast_shadows>false</cast_shadows>
      </visual>
    </link>
  </model>
</sdf>
