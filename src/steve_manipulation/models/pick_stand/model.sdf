<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="pick_stand">
    <static>true</static>
    <link name="stand">
      <collision name="collision">
        <pose>0 0 0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.25 0.8</size>
          </box>
        </geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>100000</threshold>
          </bounce>
          <!-- Lateral grip so a finger that arrives first does not skate
               the cube off the top. Lift still separates this contact. -->
          <friction>
            <ode>
              <mu>10</mu>
              <mu2>10</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>450</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.25 0.8</size>
          </box>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.38 1</ambient>
          <diffuse>0.35 0.35 0.38 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
